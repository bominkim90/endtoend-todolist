# prod Docker 빌드·ECR push 전용 (복사: cp .env.deploy.example .env.deploy)
# .env.deploy는 git에 올리지 않음 — 실제 계정 ID만 본인 값으로 채우기
#
# 백엔드는 DB·JWT·OAuth 등 런타임 env를 ECS Task Definition에서 주입합니다.
# Docker 이미지 빌드 시 별도 build-arg는 없습니다.

# ECR push 시 사용 (build만 할 때는 없어도 됨)
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=todolist-backend
