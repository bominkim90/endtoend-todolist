# 로컬 개발용 — 복사: cp .env.example .env
#
# backend/ 디렉터리에서 ./gradlew bootRun 실행 시 이 파일을 application.yml 이 로드합니다.
# 값 변경 후에는 백엔드 재시작이 필요합니다.
#
# prod ECS: 동일 키를 Task Definition 환경변수로 주입 (이 파일을 이미지에 넣지 않음)

# ── PostgreSQL (로컬) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TodoListDB
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── JWT (최소 32자 이상 랜덤 문자열) ─────────────────────────
JWT_SECRET=your-jwt-secret-at-least-32-characters

# ── Google OAuth2 (Google Cloud Console) ─────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Console「승인된 리디렉션 URI」와 완전히 동일해야 함
# 로컬: http://localhost:8080/login/oauth2/code/google
# prod: https://<백엔드-CloudFront-도메인>/login/oauth2/code/google
OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ── 프론트 연동 (CORS + OAuth 로그인 성공 후 redirect) ───────
FRONTEND_URL=http://localhost:3000

# 로컬 HTTP 개발 시 false / prod HTTPS 시 true
COOKIE_SECURE=false

# ── AWS S3 + CloudFront (Presigned URL 서명용) ──────────────
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket-name
AWS_CLOUDFRONT_DOMAIN=https://your-distribution.cloudfront.net
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ── 서버 ────────────────────────────────────────────────────
SERVER_PORT=8080
