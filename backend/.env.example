# PostgreSQL (로컬)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TodoListDB
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT (최소 32자 이상 랜덤 문자열)
JWT_SECRET=your-jwt-secret-at-least-32-characters

# Google OAuth2 (Google Cloud Console에서 발급)
# application.yml의 ${GOOGLE_CLIENT_ID} / ${GOOGLE_CLIENT_SECRET}에 연결됨
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth 콜백 redirect_uri (Google Console 승인된 리디렉션 URI와 완전히 동일해야 함)
# 로컬: http://localhost:8080/login/oauth2/code/google
# prod: https://<백엔드-CloudFront-도메인>/login/oauth2/code/google
OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# 프론트엔드 URL (CORS + OAuth 로그인 성공 후 브라우저 리다이렉트)
FRONTEND_URL=http://localhost:3000

# 로컬 개발 시 HTTPS 없으면 false
COOKIE_SECURE=false

# AWS S3 + CloudFront
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket-name
AWS_CLOUDFRONT_DOMAIN=https://your-distribution.cloudfront.net
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

SERVER_PORT=8080
