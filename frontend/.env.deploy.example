# prod Docker 빌드·ECR push 전용 (복사: cp .env.deploy.example .env.deploy)
# .env.deploy는 git에 올리지 않음 — 실제 URL/계정 ID만 본인 값으로 채우기

# 브라우저·OAuth가 호출할 백엔드 공개 URL (CloudFront HTTPS, 끝에 / 없이)
NEXT_PUBLIC_API_URL=https://your-backend-cloudfront.cloudfront.net

# ECR push 시 사용 (build만 할 때는 없어도 됨)
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=todolist-frontend
